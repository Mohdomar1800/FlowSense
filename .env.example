APP_NAME=FlowSense
APP_ENV=development
APP_DEBUG=false

# 127.0.0.1 (not "localhost", which can resolve to IPv6 first and stall) when running the API on your machine; docker compose overrides these for the api container.
POSTGRES_DB=flowsense
POSTGRES_USER=flowsense
POSTGRES_PASSWORD=flowsense
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ANALYTICS_CACHE_TTL_SECONDS=300

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

SCHEDULER_ENABLED=true
